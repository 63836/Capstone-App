<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Image Selector with CardView for elevation and rounded appearance -->
        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:cardCornerRadius="75dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/rewardImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Reward Image" />
        </androidx.cardview.widget.CardView>

        <!-- Reward Name -->
        <EditText
            android:id="@+id/rewardNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reward Name"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_background"/>

        <!-- Reward Quantity -->
        <EditText
            android:id="@+id/rewardQuantityEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_background"/>

        <!-- Points Required -->
        <EditText
            android:id="@+id/rewardPointsEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Points Required"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/edittext_background"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/submitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Reward"
            android:backgroundTint="@color/primary_green"
            android:textColor="@color/white"
            android:padding="12dp"
            android:minWidth="120dp"/>
    </LinearLayout>
</ScrollView>
